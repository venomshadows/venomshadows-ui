{
  "{% import 'venom_ui/macros.html' as ui %}{{ ui.secret_field('p', 'Password', true, clearable=true) }}": "\n\n\n\n\n\n\n\n\n<div class=\"field\">\n  <label class=\"field__label\" for=\"p\">Password</label>\n  \n<input name=\"p\" type=\"password\" value=\"\" autocomplete=\"new-password\" id=\"p\" aria-describedby=\"p-hint\" placeholder=\"•••••• (сохранён)\">\n<label class=\"checkbox-row\"><input type=\"checkbox\" name=\"p__clear\" id=\"p__clear\" value=\"1\"><span>Очистить</span></label>\n\n  <span class=\"field__hint\" id=\"p-hint\">Оставьте пустым, чтобы сохранить пароль.</span>\n  \n</div>",
  "{% import 'venom_ui/macros.html' as ui %}{{ ui.secret_field('p', 'Password', false) }}": "\n\n\n\n\n\n\n\n\n<div class=\"field\">\n  <label class=\"field__label\" for=\"p\">Password</label>\n  \n<input name=\"p\" type=\"password\" value=\"\" autocomplete=\"new-password\" id=\"p\" placeholder=\"\">\n\n\n  \n  \n</div>",
  "{% import 'venom_ui/macros.html' as ui %}{{ ui.secret_field('p', 'Password', true, placeholder_hint='custom', required=true, attrs={'id': 'custom'}) }}": "\n\n\n\n\n\n\n\n\n<div class=\"field\">\n  <label class=\"field__label\" for=\"custom\">Password</label>\n  \n<input name=\"p\" type=\"password\" value=\"\" autocomplete=\"new-password\" id=\"custom\" aria-describedby=\"custom-hint\" required=\"\" placeholder=\"custom\">\n\n\n  <span class=\"field__hint\" id=\"custom-hint\">Оставьте пустым, чтобы сохранить пароль.</span>\n  \n</div>",
  "{% import 'venom_ui/macros.html' as ui %}{{ ui.empty_state('Title', 'Text') }}": "<div class=\"empty-state\"><svg class=\"icon empty-state__icon\" viewBox=\"0 0 24 24\" width=\"1.25em\" height=\"1.25em\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" /><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\" /></svg><h2>Title</h2><p>Text</p></div>",
  "{% import 'venom_ui/macros.html' as ui %}{{ ui.status_pill('success', 'OK') }}": "<span class=\"pill pill--success\">OK</span>",
  "{% import 'venom_ui/macros.html' as ui %}{{ ui.field('token', 'Token', 'visible') }}": "\n\n\n\n\n\n\n\n\n\n<div class=\"field\">\n  <label class=\"field__label\" for=\"token\">Token</label>\n  \n<input name=\"token\" type=\"text\" value=\"visible\" id=\"token\" placeholder=\"\">\n\n  \n  \n</div>",
  "{% import 'venom_ui/list.html' as ui %}{{ ui.chips('s', 'Status', [('', 'All'), ('ok', 'OK')]) }}": "<div class=\"list-chips\" role=\"group\" aria-label=\"Status\" data-chip-group=\"s\" data-none-value=\"__none__\">\n  <input type=\"hidden\" name=\"s\" value=\"\" data-chip-value data-none-value=\"__none__\">\n    <button type=\"button\" class=\"btn chip\" data-chip=\"\"\n            aria-pressed=\"true\">All\n      <span class=\"chip__count\" data-chip-count></span>\n    </button>\n    <button type=\"button\" class=\"btn chip\" data-chip=\"ok\"\n            aria-pressed=\"false\">OK\n      <span class=\"chip__count\" data-chip-count></span>\n    </button>\n</div>",
  "{% import 'venom_ui/list.html' as ui %}{{ ui.input('date', 'Date') }}": "<label class=\"list-dropdown list-input\">\n  <span class=\"visually-hidden\">Date</span>\n  <input type=\"text\" name=\"date\" value=\"\" data-list-filter>\n</label>",
  "{% import 'venom_ui/list.html' as ui %}{{ ui.dropdown('s', 'Status', [('', 'All')]) }}": "<label class=\"list-dropdown\">\n  <span class=\"list-dropdown__label\">Status</span>\n  <span class=\"list-dropdown__control\">\n    <select name=\"s\" data-list-filter data-none-value=\"__none__\">\n        <option value=\"\" selected>All</option>\n    </select>\n    <svg class=\"icon\" viewBox=\"0 0 24 24\" width=\"1.25em\" height=\"1.25em\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"m6 9 6 6 6-6\" /></svg>\n  </span>\n</label>",
  "{% import 'venom_ui/list.html' as ui %}{% call ui.filter_bar('rows') %}Filters{% endcall %}": "\n<form class=\"filter-bar\" role=\"search\" aria-label=\"Фильтры\" data-filter-bar\n      data-target=\"rows\" data-mode=\"client\" data-persist=\"session\">\n  Filters\n  <span class=\"filter-bar__count\" data-list-count role=\"status\" aria-live=\"polite\"></span>\n    <button class=\"btn btn--secondary filter-bar__reset\" type=\"button\" data-list-reset disabled>\n      <svg class=\"icon\" viewBox=\"0 0 24 24\" width=\"1.25em\" height=\"1.25em\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M18 6 6 18\" /><path d=\"m6 6 12 12\" /></svg> Сбросить\n    </button>\n</form>",
  "{% import 'venom_ui/list.html' as ui %}{% call ui.card_list('cards') %}Rows{% endcall %}": "<ul id=\"cards\" class=\"card-list\" data-list data-reveal-on-filter=\"false\" data-list-body tabindex=\"-1\">\n  Rows\n</ul>",
  "{% import 'venom_ui/macros.html' as ui %}{% call ui.settings_section('mail', 'Mail', false) %}Fields{% endcall %}": "<section class=\"panel settings-section\" id=\"settings-mail\" aria-labelledby=\"mail-title\">\n  <div class=\"settings-section__head\"><h2 id=\"mail-title\">Mail</h2><span class=\"state-marker\"><span class=\"state-marker__dot\" aria-hidden=\"true\"></span>Не настроено</span></div>\n  \n  Fields\n</section>",
  "{% import 'venom_ui/macros.html' as ui %}{% call ui.empty_state('Empty', 'Text') %}Action{% endcall %}": "<div class=\"empty-state\"><svg class=\"icon empty-state__icon\" viewBox=\"0 0 24 24\" width=\"1.25em\" height=\"1.25em\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" /><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\" /></svg><h2>Empty</h2><p>Text</p><div class=\"empty-state__actions\">Action</div></div>"
